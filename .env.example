# Copy to .env and adjust.
DB_PASSWORD=change-me-please
PH_PORT=2342
PH_DATA_PATH=./data/library
PH_DB_PATH=./data/postgres

# Public URL (used for share links and casting), e.g. https://photos.example.com
PH_PUBLIC_URL=

# Machine learning: default is the bundled `ml` container. Point to another machine to offload it.
PH_ML_URL=http://ml:3003
PH_ML_API_KEY=

# OAuth / OpenID Connect (optional; can also be configured in the admin UI)
PH_OAUTH_ISSUER_URL=
PH_OAUTH_CLIENT_ID=
PH_OAUTH_CLIENT_SECRET=

# Automatic database backup (cron with seconds field) and how many to keep
PH_BACKUP_CRON=0 0 2 * * *
PH_BACKUP_KEEP=14
